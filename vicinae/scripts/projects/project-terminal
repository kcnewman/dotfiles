#!/usr/bin/env bash
# @vicinae.schemaVersion 1
# @vicinae.title Project in Terminal
# @vicinae.mode compact
# @vicinae.icon 💻
# @vicinae.keywords ["project","terminal","dev"]
# @vicinae.argument1 { "type": "text", "placeholder": "project name" }

project="$1"
dir="$HOME/dev/$project"

if [[ ! -d "$dir" ]]; then
  echo "Project not found: $project"
  exit 1
fi

xdg-terminal-exec --dir="$dir" >/dev/null 2>&1 &
echo "Opening terminal in $project"
