#!/usr/bin/env bash
# @vicinae.schemaVersion 1
# @vicinae.title Project with Codex
# @vicinae.mode compact
# @vicinae.icon 🤖
# @vicinae.keywords ["project","codex","ai","agent"]
# @vicinae.argument1 { "type": "text", "placeholder": "project name" }

project="$1"
dir="$HOME/dev/$project"

if [[ ! -d "$dir" ]]; then
  echo "Project not found: $project"
  exit 1
fi

xdg-terminal-exec \
  --title="Codex — $project" \
  --dir="$dir" \
  /usr/bin/zsh -ic 'codex' \
  >/dev/null 2>&1 &

echo "Starting Codex in $project"
