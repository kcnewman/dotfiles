#!/usr/bin/env bash
# @vicinae.schemaVersion 1
# @vicinae.title Project in Zed
# @vicinae.mode compact
# @vicinae.icon 📝
# @vicinae.keywords ["project","zed","code","dev"]
# @vicinae.argument1 { "type": "text", "placeholder": "project name" }

project="$1"
dir="$HOME/dev/$project"

if [[ ! -d "$dir" ]]; then
  echo "Project not found: $project"
  exit 1
fi

nohup "$HOME/.local/bin/zed" "$dir" >/dev/null 2>&1 &
echo "Opening $project in Zed"
