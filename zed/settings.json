{
    /* Core */
    "cli_default_open_behavior": "new_window",
    "collaboration_panel": {
        "dock": "left"
    },
    "diff_view_style": "unified",
    "show_edit_predictions": false,
    "edit_predictions": {
        "provider": "zed",
        "mode": "subtle"
    },
    "agent": {
        "dock": "right",
        "tool_permissions": {
            "tools": {
                "terminal": {
                    "default": "allow"
                }
            }
        },
        "profiles": {},
        "default_profile": "write",
        "default_model": {
            "provider": "copilot_chat",
            "model": "claude-haiku-4.5",
            "enable_thinking": true
        },
        "favorite_models": [],
        "model_parameters": []
    },
    "auto_update": false,
    "base_keymap": "VSCode",
    "theme": {
        "mode": "dark",
        "light": "One Light",
        "dark": "One Dark"
    },
    "icon_theme": "JetBrains New UI Icons (Dark)",
    "agent_servers": {
        "cursor": {
            "type": "registry"
        },
        "github-copilot-cli": {
            "type": "registry"
        },
        "opencode": {
            "type": "registry"
        },
        "codex-acp": {
            "type": "registry"
        }
    },
    "telemetry": {
        "diagnostics": false,
        "metrics": false
    },
    "session": {
        "trust_all_worktrees": true
    },
    /* Fonts */
    "ui_font_family": "SF Pro",
    "ui_font_size": 16,
    "buffer_font_family": "JetBrains Mono",
    "buffer_font_size": 14.0,
    "buffer_font_features": {
        "calt": true // JetBrains Mono ligatures
    },
    /* Editor */
    "gutter": {
        "line_numbers": true,
        "min_line_number_digits": 2
    },
    "relative_line_numbers": "disabled",
    "show_completions_on_input": true,
    "auto_signature_help": false,
    "hover_popover_delay": 400,
    "cursor_blink": true,
    "colorize_brackets": true,
    "auto_indent_on_paste": true,
    "linked_edits": true,
    "show_whitespaces": "boundary",
    "ensure_final_newline_on_save": true,
    "soft_wrap": "prefer_line",
    "preferred_line_length": 88,
    "hard_tabs": false,
    "tab_size": 4,
    "show_wrap_guides": true,
    "wrap_guides": [
        88
    ],
    "autosave": {
        "after_delay": {
            "milliseconds": 1000
        }
    },
    "format_on_save": "on",
    "formatter": "language_server",
    "indent_guides": {
        "enabled": true,
        "coloring": "indent_aware"
    },
    "sticky_scroll": {
        "enabled": true
    },
    /* Git */
    "git": {
        "inline_blame": {
            "enabled": true,
            "delay_ms": 600
        }
    },
    "git_panel": {
        "dock": "left",
        "tree_view": true
    },
    /* Panels */
    "tab_bar": {
        "show": false
    },
    "status_bar": {
        "experimental.show": false
    },
    "project_panel": {
        "dock": "left",
        "auto_reveal_entries": false,
        "indent_size": 16,
        "git_status": true
    },
    "outline_panel": {
        "dock": "left",
        "auto_reveal_entries": true
    },
    "preview_tabs": {
        "enabled": false
    },
    "minimap": {
        "show": "never"
    },
    /* Search */
    "search": {
        "include_ignored": true
    },
    /* Terminal */
    "terminal": {
        "keep_selection_on_copy": false,
        "cursor_shape": "bar",
        "detect_venv": {
            "on": {
                "directories": [
                    ".venv"
                ],
                "activate_script": "default"
            }
        }
    },
    /* Languages */
    "languages": {
        "Python": {
            "show_edit_predictions": false,
            "language_servers": [
                "!pyright",
                "ruff",
                "basedpyright",
            ],
            "format_on_save": "on",
            "formatter": {
                "language_server": {
                    "name": "ruff"
                }
            },
            "tab_size": 4
        },
        "JSON": {
            "tab_size": 2
        },
        "YAML": {
            "tab_size": 2
        },
        "Markdown": {
            "soft_wrap": "editor_width",
            "show_whitespaces": "none"
        },
    },
    /* LSP */
    "lsp": {
        "basedpyright": {
            "settings": {
                "basedpyright": {
                    "analysis": {
                        "autoImportCompletions": true,
                        "diagnosticMode": "openFilesOnly",
                        "typeCheckingMode": "standard"
                    }
                }
            }
        },
        "ruff": {
            "initialization_options": {
                "settings": {
                    "lineLength": 88,
                    "lint": {
                        "select": [
                            "E",
                            "F",
                            "I",
                            "UP"
                        ]
                    }
                }
            }
        },
        "texlab": {
            "settings": {
                "texlab": {
                    "build": {
                        "onSave": false,
                        "executable": "latexmk",
                        "args": [
                            "-pdf",
                            "-pv",
                            "-aux-directory=build",
                            "-output-directory=.",
                            "-interaction=nonstopmode",
                            "-synctex=1",
                            "%f"
                        ]
                    }
                }
            }
        }
    }
}
